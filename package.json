{
  "name": "@dungle-scrubs/opchain",
  "version": "0.4.4",
  "description": "Run programs with 1Password secrets, without fingerprint prompts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle-scrubs/opchain.git"
  },
  "bin": {
    "opchain": "dist/opchain",
    "oprun": "dist/oprun"
  },
  "files": [
    "dist/opchain",
    "dist/oprun",
    "README.md",
    "docs/reference.md",
    "MIGRATION.md",
    "PACKAGING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/opchain && bun build src/oprun.ts --compile --outfile dist/oprun",
    "format": "biome format --write .",
    "install-local": "./scripts/install-local.sh",
    "lint": "biome lint .",
    "pack:dry-run": "npm pack --dry-run",
    "prepare": "test -d .git && husky || true",
    "test": "bun test",
    "test:integration": "bun test test/integration",
    "test:unit": "bun test test/unit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/bun": "1.3.14",
    "commander": "15.0.0",
    "husky": "9.1.7",
    "toml": "4.3.0",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/dungle-scrubs/opchain#readme",
  "bugs": {
    "url": "https://github.com/dungle-scrubs/opchain/issues"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "publishConfig": {
    "access": "public"
  }
}
