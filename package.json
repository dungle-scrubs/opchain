{
  "name": "opchain-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/opchain",
    "format": "biome format --write .",
    "install-local": "./scripts/install-local.sh",
    "lint": "biome lint .",
    "prepare": "test -d .git && husky || true",
    "test": "bun test",
    "test:integration": "bun test test/integration",
    "test:unit": "bun test test/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "14.0.3",
    "toml": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "1.3.10",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  }
}
