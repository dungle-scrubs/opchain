#!/bin/bash
# opchain - Dual-token 1Password wrapper with secrets management
#
# Automatically selects read-only or read-write service account tokens
# from macOS Keychain based on the op subcommand being run.

set -euo pipefail

VERSION="0.3.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opchain"
CONFIG_FILE="$CONFIG_DIR/config"
SECRET_NAME="OP_SERVICE_ACCOUNT_TOKEN"

# Defaults (overridden by config file, then env vars)
DEFAULT_PROJECTS_DIR="$HOME/dev"
DEFAULT_READ_ACCOUNT="opchain-read"
DEFAULT_WRITE_ACCOUNT="opchain-write"
EXPIRES_FILE="$CONFIG_DIR/expires"
DEFAULT_EXPIRES_THRESHOLD=14
DEFAULT_LLM_ACCOUNT="opchain-llm"
DEFAULT_LLM_MODEL="anthropic/claude-3.5-haiku"
OP_CATEGORIES=(
    "Login" "Secure Note" "Credit Card" "Identity" "Password"
    "Document" "API Credential" "Bank Account" "Crypto Wallet"
    "Database" "Driver License" "Email Account" "Medical Record"
    "Membership" "Outdoor License" "Passport" "Reward Program"
    "SSH Key" "Server" "Social Security Number" "Software License"
    "Wireless Router"
)

# --- Config ---

load_config() {
    local projects_dir="$DEFAULT_PROJECTS_DIR"
    local read_account="$DEFAULT_READ_ACCOUNT"
    local write_account="$DEFAULT_WRITE_ACCOUNT"
    local expires_threshold="$DEFAULT_EXPIRES_THRESHOLD"
    local llm_account="$DEFAULT_LLM_ACCOUNT"
    local llm_model="$DEFAULT_LLM_MODEL"

    # Config file overrides defaults
    if [[ -f "$CONFIG_FILE" ]]; then
        local key value
        while IFS='=' read -r key value; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            key=$(echo "$key" | xargs)
            value=$(echo "$value" | xargs)
            case "$key" in
                projects_dir)      projects_dir="$value" ;;
                read_account)      read_account="$value" ;;
                write_account)     write_account="$value" ;;
                expires_threshold) expires_threshold="$value" ;;
                llm_account)       llm_account="$value" ;;
                llm_model)         llm_model="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi

    # Env vars override config file
    PROJECTS_DIR="${OPCHAIN_PROJECTS_DIR:-$projects_dir}"
    READ_ACCOUNT="${OPCHAIN_READ_ACCOUNT:-$read_account}"
    WRITE_ACCOUNT="${OPCHAIN_WRITE_ACCOUNT:-$write_account}"
    EXPIRES_THRESHOLD="${OPCHAIN_EXPIRES_THRESHOLD:-$expires_threshold}"
    LLM_ACCOUNT="${OPCHAIN_LLM_ACCOUNT:-$llm_account}"
    LLM_MODEL="${OPCHAIN_LLM_MODEL:-$llm_model}"

    # Expand tilde
    PROJECTS_DIR="${PROJECTS_DIR/#\~/$HOME}"
}

# --- Keychain ---

fetch_token() {
    local account="$1"
    local token
    token=$(security find-generic-password -a "$account" -s "$SECRET_NAME" -w 2>/dev/null) || {
        echo "Error: token not found in Keychain (account: $account)" >&2
        echo "" >&2
        echo "Run 'opchain setup' to configure tokens." >&2
        exit 1
    }
    echo "$token"
}

resolve_token() {
    local mode="$1"
    shift
    case "$mode" in
        read)  fetch_token "$READ_ACCOUNT" ;;
        write) fetch_token "$WRITE_ACCOUNT" ;;
        auto)
            if is_write_command "$@"; then
                fetch_token "$WRITE_ACCOUNT"
            else
                fetch_token "$READ_ACCOUNT"
            fi
            ;;
    esac
}

# --- Write detection ---

is_write_command() {
    # Non-op commands always get read token
    [[ "${1:-}" != "op" ]] && return 1

    local subcommand="${2:-}"
    local action="${3:-}"

    case "$subcommand" in
        item|vault|document|group)
            case "$action" in
                create|edit|delete|share) return 0 ;;
            esac
            ;;
    esac
    return 1
}

# --- Secrets ---

handle_secrets() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        list)     secrets_list "$@" ;;
        check)    secrets_check "$@" ;;
        validate) secrets_validate "$@" ;;
        *)
            echo "Usage: opchain secrets <list|check|validate> [path]" >&2
            exit 1
            ;;
    esac
}

secrets_list() {
    local target="${1:-.}"

    if [[ -f "$target" ]]; then
        secrets_list_file "$target"
    elif [[ -d "$target" ]]; then
        local found=0
        while IFS= read -r -d '' file; do
            found=1
            secrets_list_file "$file"
        done < <(find "$target" -name '.env.op' -print0 2>/dev/null)
        if [[ $found -eq 0 ]]; then
            echo "No .env.op files found in $target" >&2
        fi
    else
        echo "Error: $target not found" >&2
        exit 1
    fi
}

secrets_list_file() {
    local file="$1"
    echo "==> $file"
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | xargs)
        if [[ "$value" == op://* ]]; then
            echo "  $key=$value"
        fi
    done < "$file"
    echo ""
}

secrets_check() {
    local target="${1:-.}"
    local failures=0

    load_config
    local token
    token=$(fetch_token "$READ_ACCOUNT")
    export OP_SERVICE_ACCOUNT_TOKEN="$token"

    if [[ -f "$target" ]]; then
        secrets_check_file "$target" || failures=$((failures + 1))
    elif [[ -d "$target" ]]; then
        while IFS= read -r -d '' file; do
            secrets_check_file "$file" || failures=$((failures + 1))
        done < <(find "$target" -name '.env.op' -print0 2>/dev/null)
    else
        echo "Error: $target not found" >&2
        exit 1
    fi

    if [[ $failures -gt 0 ]]; then
        exit 1
    fi
}

secrets_check_file() {
    local file="$1"
    local has_failure=0
    echo "==> $file"
    while IFS='=' read -r key value; do
        [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | xargs)
        [[ "$value" != op://* ]] && continue

        if op read "$value" > /dev/null 2>&1; then
            echo "  OK   $key ($value)"
        else
            echo "  FAIL $key ($value)"
            has_failure=1
        fi
    done < "$file"
    echo ""
    return $has_failure
}

secrets_validate() {
    load_config
    local token
    token=$(fetch_token "$READ_ACCOUNT")
    export OP_SERVICE_ACCOUNT_TOKEN="$token"

    local failures=0
    local found=0

    while IFS= read -r -d '' file; do
        found=1
        secrets_check_file "$file" || failures=$((failures + 1))
    done < <(find "$PROJECTS_DIR" -name '.env.op' -print0 2>/dev/null)

    if [[ $found -eq 0 ]]; then
        echo "No .env.op files found under $PROJECTS_DIR" >&2
        exit 1
    fi

    if [[ $failures -gt 0 ]]; then
        echo "$failures file(s) with failures" >&2
        exit 1
    fi

    echo "All secrets validated."
    check_expires_warnings
}

# --- Expires ---

validate_date() {
    local input="$1"
    [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
    local roundtrip
    roundtrip=$(date -j -f "%Y-%m-%d" "$input" "+%Y-%m-%d" 2>/dev/null) || return 1
    [[ "$roundtrip" == "$input" ]]
}

days_until() {
    local target="$1"
    local target_epoch today_epoch
    target_epoch=$(date -j -f "%Y-%m-%d" "$target" "+%s" 2>/dev/null) || return 1
    today_epoch=$(date "+%s")
    echo $(( (target_epoch - today_epoch) / 86400 ))
}

expires_status() {
    local days="$1"
    if [[ $days -lt 0 ]]; then
        echo "EXPIRED"
    elif [[ $days -le $EXPIRES_THRESHOLD ]]; then
        echo "EXPIRING"
    else
        echo "OK"
    fi
}

load_expires_list() {
    EXPIRES_ITEMS=()
    [[ -f "$EXPIRES_FILE" ]] || return 0
    while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^# ]] && continue
        EXPIRES_ITEMS+=("$line")
    done < "$EXPIRES_FILE"
}

add_expires_item() {
    local ref="$1"
    mkdir -p "$CONFIG_DIR"
    if [[ -f "$EXPIRES_FILE" ]] && grep -qxF "$ref" "$EXPIRES_FILE"; then
        return 0
    fi
    echo "$ref" >> "$EXPIRES_FILE"
}

remove_expires_item() {
    local ref="$1"
    if [[ ! -f "$EXPIRES_FILE" ]]; then
        echo "No items tracked." >&2
        return 1
    fi
    if ! grep -qxF "$ref" "$EXPIRES_FILE"; then
        echo "Not tracked: $ref" >&2
        return 1
    fi
    local tmp
    tmp=$(grep -vxF "$ref" "$EXPIRES_FILE") || true
    echo "$tmp" > "$EXPIRES_FILE"
    echo "Removed: $ref"
}

handle_expires() {
    local subcmd="${1:-list}"
    shift || true

    case "$subcmd" in
        list)   expires_list "$@" ;;
        add)    expires_add "$@" ;;
        remove) expires_remove "$@" ;;
        *)
            echo "Usage: opchain expires [list|add|remove] [ref]" >&2
            exit 1
            ;;
    esac
}

expires_list() {
    load_config
    load_expires_list

    if [[ ${#EXPIRES_ITEMS[@]} -eq 0 ]]; then
        echo "No items tracked."
        echo "Use 'opchain expires add op://vault/item' to track an item."
        return 0
    fi

    local token
    token=$(fetch_token "$READ_ACCOUNT")
    export OP_SERVICE_ACCOUNT_TOKEN="$token"

    echo "==> Tracked Items"
    local ref
    for ref in "${EXPIRES_ITEMS[@]}"; do
        local date_value
        if date_value=$(op read "$ref/expires" 2>/dev/null); then
            local days
            if days=$(days_until "$date_value"); then
                local status
                status=$(expires_status "$days")
                case "$status" in
                    EXPIRED)
                        local ago=$(( -days ))
                        printf "  %-8s %s (%s, %d days ago)\n" "$status" "$ref" "$date_value" "$ago"
                        ;;
                    *)
                        printf "  %-8s %s (%s, %d days)\n" "$status" "$ref" "$date_value" "$days"
                        ;;
                esac
            else
                printf "  %-8s %s (invalid date: %s)\n" "FAIL" "$ref" "$date_value"
            fi
        else
            printf "  %-8s %s (could not read)\n" "FAIL" "$ref"
        fi
    done
}

expires_add() {
    local ref="${1:-}"
    if [[ -z "$ref" ]]; then
        echo "Usage: opchain expires add <op://vault/item>" >&2
        exit 1
    fi
    if [[ "$ref" != op://* ]]; then
        echo "Error: reference must start with op://" >&2
        exit 1
    fi
    add_expires_item "$ref"
    echo "Tracking: $ref"
}

expires_remove() {
    local ref="${1:-}"
    if [[ -z "$ref" ]]; then
        echo "Usage: opchain expires remove <op://vault/item>" >&2
        exit 1
    fi
    remove_expires_item "$ref"
}

check_expires_warnings() {
    load_expires_list
    [[ ${#EXPIRES_ITEMS[@]} -gt 0 ]] || return 0

    local warnings=()
    local ref
    for ref in "${EXPIRES_ITEMS[@]}"; do
        local date_value
        if date_value=$(op read "$ref/expires" 2>/dev/null); then
            local days
            if days=$(days_until "$date_value"); then
                local status
                status=$(expires_status "$days")
                case "$status" in
                    EXPIRED)
                        local ago=$(( -days ))
                        warnings+=("$(printf "  %-8s %s (%s, %d days ago)" "$status" "$ref" "$date_value" "$ago")")
                        ;;
                    EXPIRING)
                        warnings+=("$(printf "  %-8s %s (%s, %d days)" "$status" "$ref" "$date_value" "$days")")
                        ;;
                esac
            fi
        fi
    done

    if [[ ${#warnings[@]} -gt 0 ]]; then
        echo ""
        echo "==> Expiry Warnings"
        for line in "${warnings[@]}"; do
            echo "$line"
        done
    fi
}

# --- Create ---

require_jq() {
    command -v jq > /dev/null 2>&1 || {
        echo "Error: jq is required for 'opchain create'." >&2
        echo "Install it with: brew install jq" >&2
        exit 1
    }
}

fetch_llm_key() {
    security find-generic-password -a "$LLM_ACCOUNT" -s "OPENROUTER_API_KEY" -w 2>/dev/null || true
}

select_from_list() {
    local prompt="$1"
    shift
    local items=("$@")
    local count=${#items[@]}

    echo "$prompt" >&2
    local i
    for i in $(seq 0 $((count - 1))); do
        printf "  %d) %s\n" "$((i + 1))" "${items[$i]}" >&2
    done
    local choice
    while true; do
        read -rp "Selection [1-$count]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [[ "$choice" -ge 1 ]] && [[ "$choice" -le "$count" ]]; then
            echo "${items[$((choice - 1))]}"
            return 0
        fi
        echo "  Invalid selection." >&2
    done
}

prompt_field_value() {
    local label="$1"
    local field_type="$2"
    local hint="${3:-}"
    local display="$label"
    [[ -n "$hint" ]] && display="$label ($hint)"

    if [[ "$field_type" == "concealed" ]]; then
        local val
        read -rsp "  $display: " val
        echo "" >&2
        echo "$val"
    else
        local val
        read -rp "  $display: " val
        echo "$val"
    fi
}

llm_suggest() {
    local title="$1"
    local vault_names="$2"
    local api_key="$3"

    local categories_csv=""
    local cat
    for cat in "${OP_CATEGORIES[@]}"; do
        if [[ -n "$categories_csv" ]]; then
            categories_csv="$categories_csv, $cat"
        else
            categories_csv="$cat"
        fi
    done

    local system_prompt="You are a 1Password item creation assistant. Given an item title, suggest the best vault, category, and fields. Respond with ONLY valid JSON, no markdown fences.

Available vaults: $vault_names
Available categories: $categories_csv

Respond with this exact JSON structure:
{
  \"vault\": \"vault name\",
  \"category\": \"category name\",
  \"note\": \"optional brief note about this type of item\",
  \"fields\": [
    {\"name\": \"field name\", \"type\": \"concealed|text|url|email|date\", \"hint\": \"brief description\"}
  ]
}

Rules:
- vault must be one of the available vaults
- category must be one of the available categories
- field types: concealed (secrets/passwords/keys), text (plain text), url (URLs), email (emails), date (dates)
- suggest 1-5 relevant fields
- keep hints under 30 characters"

    local payload
    payload=$(jq -n \
        --arg model "$LLM_MODEL" \
        --arg system "$system_prompt" \
        --arg user "Create item: $title" \
        '{
            model: $model,
            temperature: 0.1,
            max_tokens: 512,
            messages: [
                {role: "system", content: $system},
                {role: "user", content: $user}
            ]
        }')

    curl -s --max-time 15 \
        -H "Authorization: Bearer $api_key" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "https://openrouter.ai/api/v1/chat/completions" 2>/dev/null || true
}

parse_llm_response() {
    local raw="$1"
    [[ -z "$raw" ]] && return 1

    # Extract content from OpenRouter response
    local content
    content=$(echo "$raw" | jq -r '.choices[0].message.content // empty' 2>/dev/null) || return 1
    [[ -z "$content" ]] && return 1

    # Strip markdown fences if present
    content=$(echo "$content" | grep -v '^\x60\x60\x60' | sed '/^$/d')

    # Validate JSON
    echo "$content" | jq empty 2>/dev/null || return 1

    # Validate category against allowed list
    local suggested_cat
    suggested_cat=$(echo "$content" | jq -r '.category // empty' 2>/dev/null) || return 1
    local valid=0
    local cat
    for cat in "${OP_CATEGORIES[@]}"; do
        if [[ "$cat" == "$suggested_cat" ]]; then
            valid=1
            break
        fi
    done
    if [[ $valid -eq 0 ]]; then
        return 1
    fi

    echo "$content"
}

handle_create() {
    local title=""
    local opt_vault=""
    local opt_category=""
    local opt_expires=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --vault)
                [[ $# -lt 2 ]] && { echo "Error: --vault requires a value" >&2; exit 1; }
                opt_vault="$2"; shift 2 ;;
            --category)
                [[ $# -lt 2 ]] && { echo "Error: --category requires a value" >&2; exit 1; }
                opt_category="$2"; shift 2 ;;
            --expires)
                [[ $# -lt 2 ]] && { echo "Error: --expires requires a YYYY-MM-DD date" >&2; exit 1; }
                opt_expires="$2"; shift 2 ;;
            --*)
                echo "Error: unknown option $1" >&2
                echo "Usage: opchain create <title> [--vault name] [--category name] [--expires YYYY-MM-DD]" >&2
                exit 1 ;;
            *)
                if [[ -z "$title" ]]; then
                    title="$1"; shift
                else
                    echo "Error: unexpected argument '$1'" >&2; exit 1
                fi ;;
        esac
    done

    if [[ -z "$title" ]]; then
        echo "Usage: opchain create <title> [--vault name] [--category name] [--expires YYYY-MM-DD]" >&2
        exit 1
    fi

    if [[ -n "$opt_expires" ]] && ! validate_date "$opt_expires"; then
        echo "Error: invalid date '$opt_expires' (expected YYYY-MM-DD)" >&2
        exit 1
    fi

    require_jq
    load_config

    # Fetch vault list
    local token
    token=$(fetch_token "$READ_ACCOUNT")
    export OP_SERVICE_ACCOUNT_TOKEN="$token"

    local vaults_json
    vaults_json=$(op vault list --format=json 2>&1) || {
        echo "Error: failed to list vaults" >&2
        echo "$vaults_json" >&2
        exit 1
    }

    local vault_names=()
    while IFS= read -r name; do
        vault_names+=("$name")
    done < <(echo "$vaults_json" | jq -r '.[].name' 2>/dev/null)

    if [[ ${#vault_names[@]} -eq 0 ]]; then
        echo "Error: no vaults found" >&2
        exit 1
    fi

    local vault_names_str=""
    local v
    for v in "${vault_names[@]}"; do
        if [[ -n "$vault_names_str" ]]; then
            vault_names_str="$vault_names_str, $v"
        else
            vault_names_str="$v"
        fi
    done

    # Try LLM suggestion if vault or category not specified
    local llm_json=""
    local llm_vault="" llm_category="" llm_note=""
    if [[ -z "$opt_vault" || -z "$opt_category" ]]; then
        local api_key
        api_key=$(fetch_llm_key)
        if [[ -n "$api_key" ]]; then
            echo "Analyzing \"$title\"..."
            local raw_response
            raw_response=$(llm_suggest "$title" "$vault_names_str" "$api_key")
            if llm_json=$(parse_llm_response "$raw_response"); then
                llm_vault=$(echo "$llm_json" | jq -r '.vault // empty')
                llm_category=$(echo "$llm_json" | jq -r '.category // empty')
                llm_note=$(echo "$llm_json" | jq -r '.note // empty')
            else
                echo "LLM unavailable, using manual selection." >&2
                llm_json=""
            fi
        fi
    fi

    # Resolve vault
    local vault="$opt_vault"
    if [[ -z "$vault" ]]; then
        if [[ -n "$llm_vault" ]]; then
            read -rp "Vault [$llm_vault]: " vault
            vault="${vault:-$llm_vault}"
        else
            vault=$(select_from_list "Select vault:" "${vault_names[@]}")
        fi
    fi

    # Resolve category
    local category="$opt_category"
    if [[ -z "$category" ]]; then
        if [[ -n "$llm_category" ]]; then
            read -rp "Category [$llm_category]: " category
            category="${category:-$llm_category}"
        else
            category=$(select_from_list "Select category:" "${OP_CATEGORIES[@]}")
        fi
    fi

    # Display LLM note if available
    if [[ -n "$llm_note" ]]; then
        echo "Note: $llm_note"
    fi

    # Collect fields
    local field_names=()
    local field_types=()
    local field_hints=()
    local field_values=()

    if [[ -n "$llm_json" ]]; then
        # Parse LLM-suggested fields
        local field_count
        field_count=$(echo "$llm_json" | jq '.fields | length')
        if [[ "$field_count" -gt 0 ]]; then
            echo ""
            echo "Suggested fields:"
            local idx
            for idx in $(seq 0 $((field_count - 1))); do
                local fname ftype fhint
                fname=$(echo "$llm_json" | jq -r ".fields[$idx].name")
                ftype=$(echo "$llm_json" | jq -r ".fields[$idx].type")
                fhint=$(echo "$llm_json" | jq -r ".fields[$idx].hint // empty")
                echo "  - $fname ($ftype)${fhint:+ -- $fhint}"
                field_names+=("$fname")
                field_types+=("$ftype")
                field_hints+=("$fhint")
            done

            echo ""
            read -rp "Use these fields? [Y/n/edit] " confirm
            confirm=$(echo "${confirm:-Y}" | tr '[:upper:]' '[:lower:]')

            case "$confirm" in
                n|no)
                    field_names=()
                    field_types=()
                    field_hints=()
                    echo "Enter fields manually (empty name to finish):"
                    while true; do
                        local fname
                        read -rp "  Field name: " fname
                        [[ -z "$fname" ]] && break
                        local ftype
                        read -rp "  Field type (text/concealed/url/email/date) [text]: " ftype
                        ftype="${ftype:-text}"
                        field_names+=("$fname")
                        field_types+=("$ftype")
                        field_hints+=("")
                    done
                    ;;
                e|edit)
                    echo "Edit fields (Enter to keep, 'x' to remove, or type new name):"
                    local new_names=() new_types=() new_hints=()
                    local i
                    for i in $(seq 0 $((${#field_names[@]} - 1))); do
                        local fname="${field_names[$i]}"
                        local ftype="${field_types[$i]}"
                        local fhint="${field_hints[$i]}"
                        local new_name
                        read -rp "  $fname ($ftype) [keep/x/new name]: " new_name
                        if [[ "$new_name" == "x" ]]; then
                            continue
                        fi
                        new_name="${new_name:-$fname}"
                        new_names+=("$new_name")
                        new_types+=("$ftype")
                        new_hints+=("$fhint")
                    done
                    echo "Add more fields (empty name to finish):"
                    while true; do
                        local fname
                        read -rp "  Field name: " fname
                        [[ -z "$fname" ]] && break
                        local ftype
                        read -rp "  Field type (text/concealed/url/email/date) [text]: " ftype
                        ftype="${ftype:-text}"
                        new_names+=("$fname")
                        new_types+=("$ftype")
                        new_hints+=("")
                    done
                    field_names=("${new_names[@]}")
                    field_types=("${new_types[@]}")
                    field_hints=("${new_hints[@]}")
                    ;;
            esac
        fi
    else
        # Manual field entry
        echo "Enter fields (empty name to finish):"
        while true; do
            local fname
            read -rp "  Field name: " fname
            [[ -z "$fname" ]] && break
            local ftype
            read -rp "  Field type (text/concealed/url/email/date) [text]: " ftype
            ftype="${ftype:-text}"
            field_names+=("$fname")
            field_types+=("$ftype")
            field_hints+=("")
        done
    fi

    # Prompt for field values
    if [[ ${#field_names[@]} -gt 0 ]]; then
        echo ""
        echo "Enter field values (leave blank to skip):"
        local i
        for i in $(seq 0 $((${#field_names[@]} - 1))); do
            local val
            val=$(prompt_field_value "${field_names[$i]}" "${field_types[$i]}" "${field_hints[$i]}")
            field_values+=("$val")
        done
    fi

    # Preview
    echo ""
    echo "==> Creating item"
    echo "  Title:    $title"
    echo "  Vault:    $vault"
    echo "  Category: $category"
    local populated=0
    local i
    for i in $(seq 0 $((${#field_names[@]} - 1))); do
        [[ -n "${field_values[$i]:-}" ]] && populated=$((populated + 1))
    done
    echo "  Fields:   $populated"
    for i in $(seq 0 $((${#field_names[@]} - 1))); do
        local val="${field_values[$i]:-}"
        [[ -z "$val" ]] && continue
        local display_val="$val"
        if [[ "${field_types[$i]}" == "concealed" ]]; then
            display_val="****"
        fi
        echo "    - ${field_names[$i]} (${field_types[$i]}): $display_val"
    done
    if [[ -n "$opt_expires" ]]; then
        echo "  Expires:  $opt_expires"
    fi

    echo ""
    read -rp "Confirm? [Y/n] " confirm
    confirm=$(echo "${confirm:-Y}" | tr '[:upper:]' '[:lower:]')
    if [[ "$confirm" == "n" || "$confirm" == "no" ]]; then
        echo "Cancelled."
        exit 0
    fi

    # Build op item create command
    local write_token
    write_token=$(fetch_token "$WRITE_ACCOUNT")
    export OP_SERVICE_ACCOUNT_TOKEN="$write_token"

    local op_args=("op" "item" "create" "--vault" "$vault" "--category" "$category" "--title" "$title")

    # Add field arguments
    local i
    for i in $(seq 0 $((${#field_names[@]} - 1))); do
        local val="${field_values[$i]:-}"
        [[ -z "$val" ]] && continue
        local ftype="${field_types[$i]}"
        # Normalize unknown types to text
        case "$ftype" in
            concealed|text|url|email|date) ;;
            *) ftype="text" ;;
        esac
        op_args+=("${field_names[$i]}[$ftype]=$val")
    done

    # Add expires field if specified
    if [[ -n "$opt_expires" ]]; then
        op_args+=("expires[date]=$opt_expires")
    fi

    # Execute
    "${op_args[@]}"
    local exit_code=$?

    if [[ $exit_code -eq 0 ]]; then
        echo "Item created successfully."
        # Auto-track for expiry if --expires was used
        if [[ -n "$opt_expires" ]]; then
            add_expires_item "op://$vault/$title"
        fi
    else
        echo "Error: op item create failed (exit code $exit_code)" >&2
        exit $exit_code
    fi
}

# --- Setup ---

setup_interactive() {
    echo "opchain setup — store dual tokens in macOS Keychain"
    echo ""

    load_config

    local accounts=("$READ_ACCOUNT" "$WRITE_ACCOUNT")
    local labels=("Read-only" "Read-write")

    for i in 0 1; do
        local account="${accounts[$i]}"
        local label="${labels[$i]}"

        echo "--- $label token (account: $account) ---"

        # Check for existing entry
        if security find-generic-password -a "$account" -s "$SECRET_NAME" > /dev/null 2>&1; then
            echo "  Existing entry found."
            read -rp "  Overwrite? [y/N] " confirm
            if [[ "$confirm" != [yY] ]]; then
                echo "  Skipped."
                echo ""
                continue
            fi
            security delete-generic-password -a "$account" -s "$SECRET_NAME" > /dev/null 2>&1 || true
        fi

        read -rsp "  Paste token: " token
        echo ""

        if [[ -z "$token" ]]; then
            echo "  Empty token, skipped."
            echo ""
            continue
        fi

        security add-generic-password -a "$account" -s "$SECRET_NAME" -w "$token"
        echo "  Stored."
        echo ""
    done

    echo "--- LLM API key (optional, account: $LLM_ACCOUNT) ---"
    echo "  OpenRouter API key for 'opchain create' suggestions."
    echo "  Get one at: https://openrouter.ai/keys"
    read -rp "  Configure LLM? [y/N] " configure_llm
    if [[ "$configure_llm" == [yY] ]]; then
        if security find-generic-password -a "$LLM_ACCOUNT" -s "OPENROUTER_API_KEY" > /dev/null 2>&1; then
            echo "  Existing entry found."
            read -rp "  Overwrite? [y/N] " confirm
            if [[ "$confirm" != [yY] ]]; then
                echo "  Skipped."
                echo ""
            else
                security delete-generic-password -a "$LLM_ACCOUNT" -s "OPENROUTER_API_KEY" > /dev/null 2>&1 || true
                read -rsp "  Paste OpenRouter API key: " llm_key
                echo ""
                if [[ -n "$llm_key" ]]; then
                    security add-generic-password -a "$LLM_ACCOUNT" -s "OPENROUTER_API_KEY" -w "$llm_key"
                    echo "  Stored."
                else
                    echo "  Empty key, skipped."
                fi
                echo ""
            fi
        else
            read -rsp "  Paste OpenRouter API key: " llm_key
            echo ""
            if [[ -n "$llm_key" ]]; then
                security add-generic-password -a "$LLM_ACCOUNT" -s "OPENROUTER_API_KEY" -w "$llm_key"
                echo "  Stored."
            else
                echo "  Empty key, skipped."
            fi
            echo ""
        fi
    else
        echo "  Skipped."
        echo ""
    fi

    echo "Done. Tokens stored in login keychain."
    echo "Set keychain items to 'Allow all applications' to avoid biometric prompts."
}

# --- Help ---

show_help() {
    cat << EOF
opchain $VERSION — Dual-token 1Password wrapper with secrets management

USAGE:
    opchain [--read|--write] <command> [args...]
    opchain create <title> [--vault name] [--category name] [--expires YYYY-MM-DD]
    opchain secrets <list|check|validate> [path]
    opchain expires [list|add|remove] [ref]
    opchain setup
    opchain --help | --version

COMMANDS:
    create <title>           Create a 1Password item with LLM-assisted suggestions
    secrets list [path]      List op:// references in .env.op files
    secrets check [path]     Resolve each op:// reference, report OK/FAIL
    secrets validate         Check all .env.op files under projects dir
    expires [list]           Show tracked items with expiry status
    expires add <ref>        Track an op:// item for expiry monitoring
    expires remove <ref>     Stop tracking an item
    setup                    Store read/write tokens in Keychain

FLAGS:
    --read       Force read-only token
    --write      Force read-write token
    --expires    Set expiry date (YYYY-MM-DD) on op item create/edit
    --help, -h   Show this help
    --version    Show version

TOKEN SELECTION:
    By default, opchain selects the token automatically:
    - Read token for: op item get, op vault list, non-op commands
    - Write token for: op item create/edit/delete/share,
      op vault/document/group create/edit/delete

EXAMPLES:
    opchain op vault list
    opchain op item create --vault Dev --title "api-key"
    opchain op item create --vault Dev --title "api-key" --expires 2026-06-15
    opchain create "Stripe API Key"
    opchain create "SSH Key" --vault Dev --category "SSH Key"
    opchain create "Token" --expires 2026-06-15
    opchain --read op vault list
    opchain --write op vault list
    opchain varlock run -- ./start.sh
    opchain secrets validate
    opchain expires
    opchain expires add op://Dev/api-key

CONFIG:
    File: ~/.config/opchain/config

    projects_dir=~/dev            Directory for secrets validate
    read_account=opchain-read     Keychain account for read token
    write_account=opchain-write   Keychain account for write token
    expires_threshold=14          Days before expiry to warn
    llm_account=opchain-llm       Keychain account for OpenRouter API key
    llm_model=anthropic/claude-3.5-haiku  LLM model for create suggestions

    Env vars (override config): OPCHAIN_PROJECTS_DIR,
    OPCHAIN_READ_ACCOUNT, OPCHAIN_WRITE_ACCOUNT,
    OPCHAIN_EXPIRES_THRESHOLD, OPCHAIN_LLM_ACCOUNT,
    OPCHAIN_LLM_MODEL

    DEPENDENCIES:
    - jq (required for 'opchain create'): brew install jq

EOF
    exit 0
}

show_version() {
    echo "opchain $VERSION"
    exit 0
}

# --- Main ---

main() {
    [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && show_help
    [[ "${1:-}" == "--version" ]] && show_version

    # Subcommands
    case "${1:-}" in
        create)
            shift
            handle_create "$@"
            exit 0
            ;;
        secrets)
            shift
            handle_secrets "$@"
            exit 0
            ;;
        expires)
            shift
            handle_expires "$@"
            exit 0
            ;;
        setup)
            setup_interactive
            exit 0
            ;;
    esac

    # No args → usage error
    [[ $# -eq 0 ]] && { echo "Usage: opchain [--read|--write] <command> [args...]" >&2; exit 1; }

    # Parse --read / --write flag
    local mode="auto"
    case "$1" in
        --read)  mode="read";  shift ;;
        --write) mode="write"; shift ;;
        --*)
            echo "Unknown flag: $1" >&2
            echo "Run 'opchain --help' for usage." >&2
            exit 1
            ;;
    esac

    [[ $# -eq 0 ]] && { echo "Error: no command provided after flag" >&2; exit 1; }

    load_config

    local token
    token=$(resolve_token "$mode" "$@")
    export OP_SERVICE_ACCOUNT_TOKEN="$token"

    # Intercept --expires on op item create/edit
    if [[ "${1:-}" == "op" && "${2:-}" == "item" ]] && \
       [[ "${3:-}" == "create" || "${3:-}" == "edit" ]]; then
        local all_args=("$@")
        local expires_date="" has_expires=0
        local new_args=()
        local skip_next=0
        for ((i = 0; i < ${#all_args[@]}; i++)); do
            if [[ $skip_next -eq 1 ]]; then
                skip_next=0
                continue
            fi
            if [[ "${all_args[$i]}" == "--expires" ]]; then
                has_expires=1
                local next=$((i + 1))
                if [[ $next -ge ${#all_args[@]} ]]; then
                    echo "Error: --expires requires a YYYY-MM-DD date" >&2
                    exit 1
                fi
                expires_date="${all_args[$next]}"
                if ! validate_date "$expires_date"; then
                    echo "Error: invalid date '$expires_date' (expected YYYY-MM-DD)" >&2
                    exit 1
                fi
                skip_next=1
            else
                new_args+=("${all_args[$i]}")
            fi
        done

        if [[ $has_expires -eq 1 ]]; then
            local action="${new_args[2]}"

            # For op item create without --category, default to API Credential
            if [[ "$action" == "create" ]]; then
                local has_category=0
                for a in "${new_args[@]}"; do
                    [[ "$a" == "--category" ]] && has_category=1
                done
                if [[ $has_category -eq 0 ]]; then
                    new_args+=("--category" "API Credential")
                fi
            fi

            # Append the expires field
            new_args+=("expires[date]=$expires_date")

            # Execute (not exec, so we can post-process)
            "${new_args[@]}"
            local exit_code=$?

            if [[ $exit_code -eq 0 ]]; then
                # Extract --vault and --title/item-name for tracking
                local vault="" title=""
                for ((j = 0; j < ${#new_args[@]}; j++)); do
                    case "${new_args[$j]}" in
                        --vault) vault="${new_args[$((j + 1))]}" ;;
                        --title) title="${new_args[$((j + 1))]}" ;;
                    esac
                done

                # For edit, the item name is the positional arg after "op item edit"
                if [[ "$action" == "edit" && -z "$title" ]]; then
                    for ((k = 3; k < ${#new_args[@]}; k++)); do
                        case "${new_args[$k]}" in
                            --*)  k=$((k + 1)); continue ;;
                            *=*)  continue ;;
                            *)    title="${new_args[$k]}"; break ;;
                        esac
                    done
                fi

                if [[ -n "$vault" && -n "$title" ]]; then
                    add_expires_item "op://$vault/$title"
                fi
            fi

            exit $exit_code
        fi
    fi

    exec "$@"
}

main "$@"
